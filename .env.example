# Токен бота, выданный @BotFather
BOT_TOKEN=

# Числовой Telegram ID владельца личного чата
ADMIN_ID=

# OpenAI-совместимый API Chat Completions
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Дополнительные текстовые модели для /model, через запятую.
# При отсутствующем параметре прямой API DeepSeek предлагает deepseek-flash и deepseek-v4-pro.
# LLM_MODELS=deepseek-flash,deepseek-v4-pro

# auto — веб-инструменты прямого API DeepSeek, off — отключить.
LLM_WEB_TOOLS=auto

# auto — deepseek-flash на прямом API DeepSeek.
# Для другого API укажите поддерживаемую им vision-модель. off отключает изображения.
LLM_VISION_MODEL=auto

# Пример для локальной Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama

# Максимальное ожидание ответа LLM в секундах
LLM_TIMEOUT=120

# Число последних пар вопрос–ответ в памяти. 0 — независимые запросы.
HISTORY_TURNS=4
